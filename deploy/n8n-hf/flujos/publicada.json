{
  "name": "produccion.publicada",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": { "path": "publicada", "httpMethod": "POST", "responseMode": "lastNode" }
    },
    {
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfor (const item of $input.all()) {\n  const h = item.json.headers || {};\n  const f = h['x-starseed-firma'] || h['X-StarSeed-Firma'] || '';\n  const cuerpo = JSON.stringify(item.json.body ?? {});\n  const esperada = 'sha256=' + crypto.createHmac('sha256', process.env.PRODUCCION_WEBHOOK_SECRETO || '').update(cuerpo).digest('hex');\n  if (f !== esperada) return [];\n  item.json = item.json.body || {};\n}\nreturn $input.all();"
      }
    },
    {
      "name": "Drive habilitado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{$env.DRIVE_HABILITADO || ''}}", "value2": "si" }
          ]
        }
      }
    },
    {
      "name": "Guardar notas en Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [660, -80],
      "parameters": {
        "operation": "upload",
        "name": "notas-version.txt",
        "binaryData": false,
        "fileContent": "={{JSON.stringify($json, null, 2)}}"
      },
      "credentials": { "googleDriveOAuth2Api": { "id": "", "name": "Drive de StarSeed" } },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Verificar firma", "type": "main", "index": 0 }]] },
    "Verificar firma": { "main": [[{ "node": "Drive habilitado", "type": "main", "index": 0 }]] },
    "Drive habilitado": { "main": [[{ "node": "Guardar notas en Drive", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {}
}
