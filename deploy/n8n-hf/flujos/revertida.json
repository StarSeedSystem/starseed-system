{
  "name": "produccion.revertida",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": { "path": "revertida", "httpMethod": "POST", "responseMode": "lastNode" }
    },
    {
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nfor (const item of $input.all()) {\n  const h = item.json.headers || {};\n  const f = h['x-starseed-firma'] || h['X-StarSeed-Firma'] || '';\n  const cuerpo = JSON.stringify(item.json.body ?? {});\n  const esperada = 'sha256=' + crypto.createHmac('sha256', process.env.PRODUCCION_WEBHOOK_SECRETO || '').update(cuerpo).digest('hex');\n  if (f !== esperada) return [];\n  item.json = item.json.body || {};\n}\nreturn $input.all();"
      }
    },
    {
      "name": "Telegram habilitado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{$env.TELEGRAM_HABILITADO || ''}}", "value2": "si" }
          ]
        }
      }
    },
    {
      "name": "Avisar por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, -80],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID || ''}}",
        "text": "=Publicación revertida: {{$json.titulo || $json.evento || 'sin detalle'}}"
      },
      "credentials": { "telegramApi": { "id": "", "name": "Telegram de StarSeed" } },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Verificar firma", "type": "main", "index": 0 }]] },
    "Verificar firma": { "main": [[{ "node": "Telegram habilitado", "type": "main", "index": 0 }]] },
    "Telegram habilitado": { "main": [[{ "node": "Avisar por Telegram", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {}
}
