# Variables de entorno para el despliegue de Oracle Always Free
# Fuente de verdad: architecture/oracle-nube.md §5
# Regla: SOLO nombres de variables; los valores viven en /etc/starseed/env (600, root)
# y los pone Alex con scripts/puente/oracle_claves.py (sin imprimirlas nunca).

# Dominio base para sslip.io o dominio propio
STARSEED_HOST=                # Subdominio base, ej. starseed.1.2.3.4.sslip.io
STARSEED_HOST_ADMIN=          # Correo para certificados TLS (Caddy)

# Claves públicas y autenticación (nunca el valor real aquí)
STARSEED_PUBLIC_KEY=          # Parte pública de ~/.ssh/starseed_oracle_ed25519
TURN_STATIC_AUTH_SECRET=      # Secreto estático para coturn (use-auth-secret)
TURN_REALM=                   # Dominio REALM de coturn
TURN_SERVER_NAME=             # Nombre del servidor TURN

# Base de datos (Postgres)
POSTGRES_USER=                # Usuario de la base de datos colectiva
POSTGRES_PASSWORD=            # Contraseña de Postgres (solo nombre de variable)
POSTGRES_DB=                  # Nombre de la base de datos

# Astraura 1.58
ASTRAURA_BUILD_CONTEXT=       # Ruta al repo astraura para build del contenedor
ASTRAURA_DOCKERFILE=          # Nombre del Dockerfile dentro del contexto
ASTRAURA_MESH_KEY=            # Clave para los pares de la malla que hablan con Astraura

# Malla StarSeed
MESH_BUILD_CONTEXT=           # Ruta al contexto de build del servidor de malla
MESH_DOCKERFILE=              # Nombre del Dockerfile del servidor de malla
MESH_KEY=                     # Clave del servidor de malla

# Automatizaciones
N8N_USER=                     # Usuario de autenticación básica para n8n
N8N_PASSWORD=                 # Contraseña básica de n8n (solo nombre de variable)

# Otros
MTX_PROTOCOLS=                # Protocolos de MediaMTX (tcp,udp)
