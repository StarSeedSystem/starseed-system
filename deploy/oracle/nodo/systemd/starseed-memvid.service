[Unit]
Description=StarSeed · servidor de cápsulas Memvid (MVD1027I · architecture/memvid-capsulas.md)
After=network-online.target
Wants=network-online.target
# requiere: /home/starseed/memvid-servidor/target/release/memvid-servidor

[Service]
User=starseed
Group=starseed
WorkingDirectory=/home/starseed
# Solo en 127.0.0.1:4490 (lo fija el propio servidor) y con el token de ~/.starseed/memvid.token
# (0600) de este usuario: nunca va en la unidad ni en el repo.
ExecStart=/home/starseed/memvid-servidor/target/release/memvid-servidor
Environment=STARSEED_MEMVID_DIR=/var/lib/starseed/memvid
Environment=MEMVID_TELEMETRY=0
Restart=on-failure
RestartSec=20
# Cápsulas de 50 MB como mucho: 512 MB sobran y el A1 comparte la RAM con el enjambre.
MemoryMax=512M
# Recuerdos en segundo plano: el enjambre manda en la CPU.
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
