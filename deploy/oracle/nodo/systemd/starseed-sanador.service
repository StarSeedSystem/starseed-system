[Unit]
Description=StarSeed · Sanador de sesiones: comprobación y reparación automática (SES1113C)
After=network-online.target
Wants=network-online.target
# requiere: /home/starseed/starseed-system/scripts/puente/sanador_sesiones.py
# requiere: /home/starseed/starseed-system/scripts/puente/sanador_recetas.py

[Service]
Type=oneshot
User=starseed
Group=starseed
WorkingDirectory=/home/starseed/starseed-system
Environment=STARSEED_ROOT=/home/starseed/starseed-system PYTHONUNBUFFERED=1
Environment=HOME=/home/starseed
Environment=PATH=/home/starseed/.local/bin:/home/starseed/bin:/home/starseed/.npm-global/bin:/home/starseed/.starseed/venvs/notebooklm/bin:/usr/local/bin:/usr/bin:/bin
Environment=NOTEBOOKLM_BIN=/home/starseed/.starseed/venvs/notebooklm/bin/notebooklm
Environment=HIGGSFIELD_BIN=/home/starseed/.npm-global/bin/higgsfield
ExecStart=/usr/bin/python3 /home/starseed/starseed-system/scripts/puente/sanador_sesiones.py comprobar
TimeoutStartSec=300
MemoryMax=500M
Nice=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target