[Unit]
Description=StarSeed · Navegador propio: vigilia, lectura y reparación diaria (NAV1112J)
# requiere: scripts/puente/navegador_alta.py, scripts/puente/navegador_reparar.py, lectores de actividad

[Timer]
# Diario a las 23:40 en America/Mexico_City (el nodo A1 usa esta zona horaria)
OnCalendar=*-*-* 23:40:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target