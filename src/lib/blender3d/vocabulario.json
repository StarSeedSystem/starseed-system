{
  "version": 1,
  "topes": {
    "operaciones": 256,
    "ancho": 4096,
    "alto": 4096,
    "muestras": 1024,
    "fotogramas": 1800,
    "segundos": 1800,
    "vertices": 2000000
  },
  "operaciones": {
    "primitiva": {
      "estado": "listo",
      "params": {
        "tipo": {
          "t": "enum",
          "v": ["cubo", "esfera", "icosfera", "cilindro", "cono", "toro", "plano", "circulo"]
        },
        "nombre": {
          "t": "nombre"
        },
        "tam": {
          "t": "num",
          "min": 0.001,
          "max": 1000
        },
        "segmentos": {
          "t": "num",
          "min": 3,
          "max": 128
        }
      }
    },
    "transformar": {
      "estado": "listo",
      "params": {
        "objeto": {
          "t": "ref"
        },
        "ubicacion": {
          "t": "vec",
          "n": 3,
          "min": -10000,
          "max": 10000
        },
        "rotacion": {
          "t": "vec",
          "n": 3,
          "min": -3600,
          "max": 3600
        },
        "escala": {
          "t": "vec",
          "n": 3,
          "min": 0.001,
          "max": 1000
        }
      }
    },
    "material": {
      "estado": "listo",
      "params": {
        "objeto": {
          "t": "ref"
        },
        "color": {
          "t": "rgba"
        },
        "metalico": {
          "t": "num",
          "min": 0,
          "max": 1
        },
        "rugosidad": {
          "t": "num",
          "min": 0,
          "max": 1
        },
        "emision_color": {
          "t": "rgba"
        },
        "emision_fuerza": {
          "t": "num",
          "min": 0,
          "max": 1000
        },
        "alfa": {
          "t": "num",
          "min": 0,
          "max": 1
        }
      }
    },
    "modificador": {
      "estado": "listo",
      "params": {
        "objeto": {
          "t": "ref"
        },
        "tipo": {
          "t": "enum",
          "v": ["subdivision", "bisel", "solidificar", "espejo", "matriz", "decimar", "malla_alambre"]
        },
        "niveles": {
          "t": "num",
          "min": 0,
          "max": 4,
          "ent": true
        },
        "ancho": {
          "t": "num",
          "min": 0,
          "max": 10
        },
        "espesor": {
          "t": "num",
          "min": -10,
          "max": 10
        },
        "cantidad": {
          "t": "num",
          "min": 1,
          "max": 100,
          "ent": true
        },
        "relacion": {
          "t": "num",
          "min": 0,
          "max": 1
        },
        "desplazamiento": {
          "t": "vec",
          "n": 3,
          "min": -10000,
          "max": 10000
        }
      }
    },
    "texto3d": {
      "estado": "listo",
      "params": {
        "nombre": {
          "t": "nombre"
        },
        "texto": {
          "t": "txt",
          "max": 64,
          "patron": "^[A-Za-z0-9 tildesñ.,:;!?¡¿'()+-]+$"
        },
        "extrusion": {
          "t": "num",
          "min": 0,
          "max": 10
        },
        "tam": {
          "t": "num",
          "min": 0.01,
          "max": 100
        }
      }
    },
    "camara": {
      "estado": "listo",
      "params": {
        "nombre": {
          "t": "nombre"
        },
        "ubicacion": {
          "t": "vec",
          "n": 3,
          "min": -10000,
          "max": 10000
        },
        "mira_a": {
          "t": "vec",
          "n": 3,
          "min": -10000,
          "max": 10000
        },
        "lente_mm": {
          "t": "num",
          "min": 8,
          "max": 300
        },
        "ortografica": {
          "t": "bool"
        }
      }
    },
    "luz": {
      "estado": "listo",
      "params": {
        "nombre": {
          "t": "nombre"
        },
        "tipo": {
          "t": "enum",
          "v": ["sol", "punto", "foco", "area"]
        },
        "color": {
          "t": "rgba"
        },
        "energia": {
          "t": "num",
          "min": 0,
          "max": 1000000
        },
        "ubicacion": {
          "t": "vec",
          "n": 3,
          "min": -10000,
          "max": 10000
        },
        "rotacion": {
          "t": "vec",
          "n": 3,
          "min": -3600,
          "max": 3600
        }
      }
    },
    "mundo": {
      "estado": "listo",
      "params": {
        "color": {
          "t": "rgba"
        },
        "fuerza": {
          "t": "num",
          "min": 0,
          "max": 100
        },
        "hdri": {
          "t": "ruta",
          "ext": ["hdr", "exr"]
        }
      }
    },
    "importar": {
      "estado": "listo",
      "params": {
        "archivo": {
          "t": "ruta",
          "ext": ["glb", "gltf", "obj", "stl", "ply", "fbx", "svg"]
        },
        "nombre": {
          "t": "nombre"
        }
      }
    },
    "animar": {
      "estado": "listo",
      "params": {
        "objeto": {
          "t": "ref"
        },
        "propiedad": {
          "t": "enum",
          "v": ["ubicacion", "rotacion", "escala"]
        },
        "claves": {
          "t": "lista",
          "de": {
            "t": "obj",
            "campos": {
              "fotograma": {
                "t": "num",
                "min": 0,
                "max": 1800,
                "ent": true
              },
              "valor": {
                "t": "vec",
                "n": 3,
                "min": -10000,
                "max": 10000
              }
            }
          },
          "max": 64
        },
        "interpolacion": {
          "t": "enum",
          "v": ["lineal", "suave", "bezier"],
          "opc": true
        }
      }
    },
    "remallar": {
      "estado": "proximamente",
      "motivo": "hoy lo hace servicios/taller-3d; llega en una ola posterior",
      "params": {}
    }
  },
  "salidas": {
    "render_png": {
      "params": {
        "ancho": {
          "t": "num",
          "min": 16,
          "max": 4096
        },
        "alto": {
          "t": "num",
          "min": 16,
          "max": 4096
        },
        "muestras": {
          "t": "num",
          "min": 1,
          "max": 1024
        },
        "motor": {
          "t": "enum",
          "v": ["workbench", "cycles-cpu", "cycles-gpu", "eevee"]
        },
        "fondo_transparente": {
          "t": "bool"
        }
      }
    },
    "render_mp4": {
      "params": {
        "ancho": {
          "t": "num",
          "min": 16,
          "max": 4096
        },
        "alto": {
          "t": "num",
          "min": 16,
          "max": 4096
        },
        "fps": {
          "t": "num",
          "min": 1,
          "max": 60
        },
        "desde": {
          "t": "num",
          "min": 0,
          "max": 1800
        },
        "hasta": {
          "t": "num",
          "min": 0,
          "max": 1800
        },
        "muestras": {
          "t": "num",
          "min": 1,
          "max": 1024
        },
        "motor": {
          "t": "enum",
          "v": ["workbench", "cycles-cpu", "cycles-gpu", "eevee"]
        }
      }
    },
    "render_exr": {
      "params": {
        "ancho": {
          "t": "num",
          "min": 16,
          "max": 4096
        },
        "alto": {
          "t": "num",
          "min": 16,
          "max": 4096
        },
        "muestras": {
          "t": "num",
          "min": 1,
          "max": 1024
        },
        "motor": {
          "t": "enum",
          "v": ["workbench", "cycles-cpu", "cycles-gpu", "eevee"]
        }
      }
    },
    "exportar_glb": {
      "params": {
        "objetos": {
          "t": "lista",
          "de": {
            "t": "obj",
            "campos": {}
          },
          "max": 64
        },
        "y_arriba": {
          "t": "bool"
        },
        "aplicar_modificadores": {
          "t": "bool"
        },
        "draco": {
          "t": "bool"
        },
        "meshopt": {
          "t": "bool"
        }
      }
    }
  }
}