# /etc/starseed/puerta-datos.env (root:starseed 640). SOLO nombres aquí; los valores los pone
# `scripts/puente/puerta_datos.py desplegar` desde ~/.starseed/env de la neurona, sin imprimirlos.
# URL del proyecto del OS (pública) y su clave pública (anon). NUNCA la clave de servicio.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Llave propia de la puerta para `puerta_datos_replicar` (su sha256 se registra en Supabase).
PUERTA_LLAVE_REPLICA=
# Opcionales
PUERTA_PUERTO=8791
PUERTA_REPLICA_DIA=1500
PUERTA_REPLICA_CADA_S=300
PUERTA_ORIGENES=
# GEN1114 · escribir desde la web al A1 (puente de Peticiones). Vacío = cerrado (fase 1a: 403 destino-cerrado).
# Solo se pone a 1 en la fase 1b, cuando el bot del A1 corra el checkout del repo con GEN1114D.
PUERTA_GENESIS_A1_ESCRITURA=
