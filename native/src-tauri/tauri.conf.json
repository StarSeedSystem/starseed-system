{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarSeed OS",
  "version": "0.1.3",
  "identifier": "app.starseed.os",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "https://starseed-os.vercel.app",
    "devUrl": "https://starseed-os.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StarSeed OS",
        "url": "https://starseed-os.vercel.app",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": ["default", "desktop-only"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Sistema Operativo Social Descentralizado StarSeed",
    "longDescription": "StarSeed OS — el sistema operativo social descentralizado de la Sociedad StarSeed, empaquetado como aplicación nativa con actualización incremental in-app y compañero de dispositivo (control por terminal con permiso del usuario).",
    "copyright": "© 2026 StarSeedSystem — AGPL-3.0-or-later",
    "publisher": "StarSeedSystem",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3QkU5NDA5Mzg0RDE1QjYKUldTMkZVMDRDWlMrZDZEMEt4NzdVaHNQT2sxR0E2aVlzUWNQeWdrVDFubWZLbThHaFVmb25Sc1gK",
      "endpoints": [
        "https://github.com/StarSeedSystem/starseed-system/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["starseed"]
      }
    }
  }
}
