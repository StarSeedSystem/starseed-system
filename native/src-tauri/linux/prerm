#     if [ -z "$(ls -A "${LOG_DIR}" 2>/dev/null)" ]; then
#         msg "Eliminando directorio de logs ${LOG_DIR} (vacío)..."
#         rmdir "${LOG_DIR}" 2>/dev/null || true
#     fi
# fi

# if [ -d "${CONFIG_DIR}" ]; then
#     if [ -z "$(ls -A "${CONFIG_DIR}" 2>/dev/null)" ]; then
#         msg "Eliminando directorio de configuración ${CONFIG_DIR} (vacío)..."
#         rmdir "${CONFIG_DIR}" 2>/dev/null || true
#     fi
# fi

# Nota: El grupo 'starseed' NO se elimina automáticamente, pues puede
# tener otros usuarios o usos. El administrador del sistema decide
# si eliminarlo con: groupdel starseed

msg "prerm completado correctamente."
exit 0