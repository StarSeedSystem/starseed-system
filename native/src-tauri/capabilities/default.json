{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "default",
  "description": "Capability principal de StarSeed Native. Concede a Aurora (la web remota desplegada) CONTROL PROFUNDO del dispositivo tras la instalación nativa: terminal, procesos, archivos, sistema, notificaciones, diálogos y deep-links. (Autoarranque y updater viven en desktop.json: son plugins solo-escritorio y sus permisos no existen en Android/iOS.) Todos los permisos están DECLARADOS y limitados por su scope; el usuario los concede al instalar y ejecutar la app nativa. Un navegador por seguridad NO puede hacer esto — por eso existe este cuerpo nativo. Desde la APP1107A (2026-11-07) también el servidor local de StarSeed OS dentro de la app: SOLO los diez orígenes http://127.0.0.1:47610…47619 (los puertos fijos de src/servidor_local_logica.rs; el servidor solo escucha en 127.0.0.1 y Rust comprueba su firma antes de llevar la ventana ahí). Desde la APP1107B (2026-11-07) también los permisos `allow-<comando>` de los comandos propios de la app (generados en build.rs): desde tauri 2.11.1 una página de un origen remoto no llega a ningún comando propio sin ellos.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows", "android", "iOS"],
  "remote": {
    "urls": [
      "https://starseed-os.vercel.app",
      "https://starseed-nexus.vercel.app",
      "https://starseed-cafe.vercel.app",
      "http://127.0.0.1:47610",
      "http://127.0.0.1:47611",
      "http://127.0.0.1:47612",
      "http://127.0.0.1:47613",
      "http://127.0.0.1:47614",
      "http://127.0.0.1:47615",
      "http://127.0.0.1:47616",
      "http://127.0.0.1:47617",
      "http://127.0.0.1:47618",
      "http://127.0.0.1:47619"
    ]
  },
  "permissions": [
    "core:default",
    "core:app:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:path:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",

    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "sh",
          "cmd": "sh",
          "args": ["-c", { "validator": "\\S+" }],
          "sidecar": false
        },
        {
          "name": "bash",
          "cmd": "bash",
          "args": ["-c", { "validator": "\\S+" }],
          "sidecar": false
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": ["/C", { "validator": "\\S+" }],
          "sidecar": false
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": ["-Command", { "validator": "\\S+" }],
          "sidecar": false
        }
      ]
    },
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "shell:allow-open",

    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/**" }, { "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPDATA/**" }, { "path": "$APPCONFIG/**" }, { "path": "$APPLOCALDATA/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DOWNLOAD/**" }, { "path": "$DESKTOP/**" }]
    },
    "fs:default",

    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "os:allow-family",
    "os:allow-arch",
    "os:allow-hostname",
    "os:allow-locale",
    "os:allow-exe-extension",

    "process:allow-exit",
    "process:allow-restart",

    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "deep-link:default",

    "allow-run-terminal",
    "allow-check-update",
    "allow-reiniciar-para-actualizar",
    "allow-estado-actualizacion",
    "allow-device-info",
    "allow-info-neurona",
    "allow-buscar-actualizacion",
    "allow-pista-neurona",
    "allow-pista-neurona-leer",
    "allow-medios-estado",
    "allow-medios-abrir-ajustes",
    "allow-recursos-ia-detectar",
    "allow-antenas-estado",
    "allow-antenas-medir",
    "allow-antenas-config",
    "allow-antenas-configurar",
    "allow-fondo-estado",
    "allow-fondo-fijar",
    "allow-fondo-arranque",
    "allow-fondo-pedir-bateria",
    "allow-carpetas-listar",
    "allow-carpetas-conceder",
    "allow-carpetas-revocar",
    "allow-carpetas-nas",
    "allow-serie-puertos",
    "allow-serie-abrir",
    "allow-serie-escribir",
    "allow-serie-cerrar",
    "allow-capas-estado",
    "allow-capas-descargar",
    "allow-capas-verificar",
    "allow-capas-borrar",
    "allow-nas-listar",
    "allow-nas-leer",
    "allow-malla-local-enviar",
    "allow-malla-local-estado",
    "allow-malla-local-recibidos",
    "allow-ble-estado",
    "allow-ble-abrir",
    "allow-ble-cerrar",
    "allow-ble-enviar",
    "allow-ble-recibidos",
    "allow-ble-activar",
    "allow-ble-pedir-permiso",
    "allow-apk-actualizar",
    "allow-apk-estado",
    "allow-apk-instalar",
    "allow-aviso-mensaje",
    "allow-avisos-config",
    "allow-avisos-estado",
    "allow-avisos-pedir-permiso",
    "allow-avisos-pendiente",
    "allow-origen-local-estado",
    "allow-rescate-origen-exportar",
    "allow-rescate-origen-estado",
    "allow-rescate-origen-datos",
    "allow-rescate-origen-confirmar"
  ]
}
