# ══════════════════════════════════════════════════════════════════════════════
# Plantilla de variables de entorno de StarSeed OS
# Copia este archivo a `.env.local` y rellena SOLO los nombres que necesites.
# NUNCA subas valores reales al repositorio: aquí todo va vacío.
# Todas las claves viven en archivos de entorno (`.env.local`, `~/.hermes/.env`).
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor, nunca al cliente.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# ── IA / Proveedores y pasarelas ──────────────────────────────────────────────
# Claves de proveedores de IA y pasarelas de la flota
XAI_API_KEY=
OPENROUTER_SHARED_KEY=
OPENROUTER_API_KEY=
NVIDIA_SHARED_KEY=
NVIDIA_API_KEY=
XKIRO_API_KEY=
AIHUBMIX_API_KEY=
TOKENROUTER_API_KEY=
LLM7_API_KEY=
FREETHEAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
STARSEED_PASARELA_APINEX_KEY=
STARSEED_PASARELA_GROQ_KEY=
STARSEED_PASARELA_OPENAI_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Backend Astraura 1.58-bit primario y cerebro local
ASTRAURA_158_URL=
ASTRAURA_158_KEY=
NEXT_PUBLIC_ASTRAURA_158_URL=
ASTRAURA_158_LOCAL_URL=
ASTRAURA_158_DIR=
