# ── Correo ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
BREVO_API_KEY=
# Dominio de correo público del OS.
NEXT_PUBLIC_STARSEED_MAIL_DOMAIN=
# Secreto para derivar códigos OTP (verificación).
OTP_HASH_SECRET=

# ── Voz ───────────────────────────────────────────────────────────────────────
