OLLAMA_MODEL=
OLLAMA_TIMEOUT=
STARSEED_JEV_TOKEN=
STARSEED_JEV_LOCAL_URL=
STARSEED_BASE_URL=

# Servicios de IA, agentes e integraciones (Stitch, OpenViking, Bonsai, AgentHarness)
STITCH_API_KEY=
STITCH_MCP_URL=
STITCH_PROJECT_ID=
OPENVIKING_URL=
OPENVIKING_API_KEY=
OPENVIKING_AGENT_ID=
