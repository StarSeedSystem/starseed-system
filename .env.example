VOZ_DAEMON_URL=
STARSEED_VOZ_DAEMON_URL=
STARSEED_VOZ_DIR=
# Modelo de TTS por Gemini usado en el nivel «nube».
STARSEED_TTS_GEMINI_MODEL=
VOZ_INSTRUCT=
VOZ_PERSONALITY=
VOZ_SPEED=
STARSEED_VOZ_HEALTH_MS=
STARSEED_VOZ_HEALTH_MAX_MS=
