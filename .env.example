# Plantilla de entorno de StarSeed OS.
# Copia a .env.local y rellena SOLO los nombres; nunca subas valores reales al repo.

# ─── Supabase ───────────────────────────────────────────────────────────────────
# URL del proyecto Supabase del OS (pública en el cliente)
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima de Supabase (pública en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SOLO servidor, nunca en el cliente
SUPABASE_SERVICE_ROLE_KEY=

# ─── IA / Proveedores comunitarios ──────────────────────────────────────────────
# Backend Astraura 1.58-bit (nube): URL y clave del puente
ASTRAURA_158_URL=
ASTRAURA_158_KEY=
# URL del backend 158 expuesta al navegador
NEXT_PUBLIC_ASTRAURA_158_URL=
# Endpoint local del modelo Astraura 158 (BitNet)
ASTRAURA_158_LOCAL_URL=
# Directorio de datos del modelo 158
ASTRAURA_158_DIR=
# Nube Astraura (alternativa al 158)
ASTRAURA_CLOUD_URL=
# Endpoint local de Astraura
ASTRAURA_LOCAL_URL=
# Puerto del servidor BitNet local
ASTRAURA_BITNET_PORT=
# URL de Astraura Bonsai
ASTRAURA_BONSAI_URL=
# Clave de Gemini (fallback: GOOGLE_API_KEY)
GEMINI_API_KEY=
# Clave de Google para Gemini/Pollinations (alias de GEMINI_API_KEY en voz nube)
GOOGLE_API_KEY=
# Clave de xAI (voz conversacional; solo servidor)
XAI_API_KEY=
# Clave compartida del proxy /api/ai/nvidia (solo servidor)
NVIDIA_SHARED_KEY=
# Claves NVIDIA extra 2/3/4 para rotación (opcional, ver /api/laboratorio)
NVIDIA_SHARED_KEY_2=
NVIDIA_SHARED_KEY_3=
NVIDIA_SHARED_KEY_4=
# Clave compartida del proxy /api/ai/openrouter (solo servidor)
OPENROUTER_SHARED_KEY=
# Stitch (generación de UI): clave, MCP y proyecto
STITCH_API_KEY=
STITCH_MCP_URL=
STITCH_PROJECT_ID=
# OpenViking: agente externo
OPENVIKING_URL=
OPENVIKING_API_KEY=
OPENVIKING_AGENT_ID=
# Bonsai (LLM): endpoint y parámetros
BONSAI_ENDPOINT=
BONSAI_MODEL=
BONSAI_FAMILY=
BONSAI_KV4=
BONSAI_NGL=
BONSAI_REASONING_BUDGET=
BONSAI_SPECULATIVE=
BONSAI_VISION=

# ─── Correo ─────────────────────────────────────────────────────────────────────
# Resend: envío de correo transaccional
RESEND_API_KEY=
# Brevo: alternativa de correo transaccional
BREVO_API_KEY=
# Dominio de correo de StarSeed (público en el cliente)
NEXT_PUBLIC_STARSEED_MAIL_DOMAIN=
# Secreto para hashear OTP de verificación (solo servidor)
OTP_HASH_SECRET=

# ─── Voz (daemon OmniVoice local 127.0.0.1:4500) ────────────────────────────────
# URL del daemon OmniVoice; alias de STARSEED_VOZ_DAEMON_URL
VOZ_DAEMON_URL=
# URL preferida del daemon de voz del OS
STARSEED_VOZ_DAEMON_URL=
# Directorio de datos del daemon de voz
STARSEED_VOZ_DIR=
# Modelo TTS de Gemini para síntesis nube
STARSEED_TTS_GEMINI_MODEL=
# Instrucciones/prompt de estilo para la voz (solo tokens del whitelist del daemon)
VOZ_INSTRUCT=
# Personalidad de la voz
VOZ_PERSONALITY=
# Velocidad de habla (p. ej. 1.0)
VOZ_SPEED=
# Plazo (ms) para que /health del daemon responda «ok»
STARSEED_VOZ_HEALTH_MS=
# Tope (ms) de espera del sondeo de salud
STARSEED_VOZ_HEALTH_MAX_MS=
# URL del backend Astraura que el daemon de voz usa como sistema primario
STARSEED_ASTRAURA_URL=
# Ruta explícita al binario ffmpeg (opcional; si no, se busca en el PATH)
STARSEED_FFMPEG=
# Directorio de vibeasr.cpp para el reconocimiento de voz
STARSEED_VIBEASR_DIR=
# Hilos de CPU para VibeASR
STARSEED_VIBEASR_HILOS=
# Plazo (ms) de la primera carga del modelo ASR
STARSEED_ASR_CARGA_MS=
# Sueño (ms) del pool ASR entre sondeos (variante con Ñ, tiene preferencia)
STARSEED_ASR_SUEÑO_MS=
# Sueño (ms) del pool ASR entre sondeos (variante ASCII)
STARSEED_ASR_SUENO_MS=
# MB mínimos de RAM libres para arrancar ASR
STARSEED_ASR_MEM_MIN_MB=
# MB de RAM que disparan el recalentamiento del pool
STARSEED_ASR_RECALENTAR_MB=
# Inactividad (ms) del pool TTS que permiten despertar ASR
STARSEED_ASR_TTS_INACTIVO_MS=

# ─── Despliegue / GCP / Vercel ──────────────────────────────────────────────────
# Entorno de Node: development | production | test
NODE_ENV=
# Service worker: «1» lo activa en el cliente
NEXT_PUBLIC_ENABLE_SW=
# Proyecto GCP para Cloud Run
GCP_PROJECT_ID=
# Alias del proyecto GCP (gcloud/ADC)
GOOGLE_CLOUD_PROJECT=
# Ruta al JSON de credenciales de servicio de Google
GOOGLE_APPLICATION_CREDENTIALS=
# JSON de la clave de la cuenta de servicio (despliegues CI)
GCP_SA_KEY_JSON=
# Bucket de GCS para backups/artefactos
GCS_BUCKET=
# Nombre del servicio en App Engine
GAE_SERVICE=
# Nombre del servicio en Cloud Run
K_SERVICE=
# Host de metadata de GCP (solo emuladores/simuladores locales)
GCE_METADATA_HOST=
# «1» marca la plataforma Vercel (la define la plataforma, no se configura)
VERCEL=
# «1» indica ejecución local del OS (no producción)
STARSEED_LOCAL=
# Raíz del repo principal (worktrees del enjambre y rutas del Mando)
STARSEED_ROOT=
# Directorio de worktrees del enjambre
STARSEED_WT=
# Carpeta de logs de las olas del enjambre
STARSEED_OLAS_LOG_DIR=
# «1» activa el Puente de Mando en la App
STARSEED_MANDO=
# Secreto HMAC para firmar órdenes de lanzamiento entre Mac y nube
STARSEED_LANZADOR_SECRETO=

# ─── Otras integraciones ────────────────────────────────────────────────────────
# Client ID de Google para OAuth/Drive (PKCE; público en el cliente)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Secreto OAuth de Google Drive (canje de código, solo servidor)
GOOGLE_OAUTH_CLIENT_SECRET=
# WebSocket del puente Hermione (público en el cliente)
NEXT_PUBLIC_HERMIONE_WS=
# WebSocket del servidor Hermione/Hermes (lado cliente de escritorio)
HERMIONE_HERMES_WS=
# WebSocket Hermes (alias interno de HERMIONE_HERMES_WS)
HERMAYONE_HERMES_WS=
# URL del AgentHarness externo
AGENTHARNESS_URL=
# OAuth de Openverse (búsqueda de imágenes)
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# «1» permite al proxy de integraciones alcanzar hosts privados (solo dev)
INTEGRATIONS_PROXY_ALLOW_PRIVATE=
# Memoria cuántica: ruta de la base de vectores
QM_DB_PATH=
# Dimensiones de los embeddings de la memoria cuántica
QM_DIMENSIONS=
# Modelo de embeddings de la memoria cuántica
QM_EMBED_MODEL=
# Cuantización de vectores de la memoria cuántica
QM_QUANTIZATION=
