{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarSeed OS",
  "version": "0.1.0",
  "identifier": "org.starseed.os",
  "build": {
    "devUrl": "http://localhost:9002",
    "frontendDist": "https://starseed-os.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StarSeed OS",
        "url": "https://starseed-os.vercel.app",
        "width": 1360,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://starseed-os.vercel.app; script-src 'self' 'unsafe-inline' https://starseed-os.vercel.app; connect-src 'self' https: wss: http://127.0.0.1:* http://localhost:*; img-src 'self' https: data: blob:; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-src 'self' https: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/StarSeedSystem/starseed-system/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGNzA5QzREOUMzOTFDRTUKUldUbEhEbWNUWnh3N3dCUlpQNmtIM05NOUs3Mmt0TkRzRXFleHdzYmlIaUVHd2poWDluM1JsVFQK"
    }
  }
}
