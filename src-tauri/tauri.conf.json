{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarSeed OS",
  "version": "0.1.0",
  "identifier": "org.starseed.os",
  "build": {
    "devUrl": "http://localhost:9002",
    "frontendDist": "https://starseed-os.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StarSeed OS",
        "url": "https://starseed-os.vercel.app",
        "width": 1360,
        "height": 860,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/StarSeedSystem/starseed-system/releases/latest/download/latest.json"
      ],
      "pubkey": "PENDIENTE_GENERAR_CON__npx_tauri_signer_generate"
    }
  }
}
